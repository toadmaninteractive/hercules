<Window x:Class="Hercules.View.WindowMain"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hc="clr-namespace:Hercules.Controls"
    xmlns:h="clr-namespace:Hercules"
    xmlns:shell="clr-namespace:Hercules.Shell"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance h:MainViewModel}"
    MinWidth="760" Width="760" MinHeight="400" Height="490"
    WindowStartupLocation="CenterScreen"
    FontSize="12" FontWeight="Bold"
    Background="WhiteSmoke"
    ResizeMode="CanResize"
    WindowStyle="ThreeDBorderWindow"
    Icon="/Hercules;component/hercules.ico"
    UseLayoutRounding="True"
    Name="MainWindow"
    SnapsToDevicePixels="True"
    WindowState="Maximized"
    Loaded="Window_Loaded"
    Closing="Window_Closing"
    Closed="Window_Closed"
    Title="{Binding ConnectionsModule.Connections.ActiveConnection.Title, Converter={StaticResource AppTitleConverter}, FallbackValue='Hercules'}"
    PreviewGotKeyboardFocus="MainWindow_PreviewGotKeyboardFocus"
    hc:RoutedCommandBindings.CommandBindings="{Binding RoutedCommandBindings}"
    hc:RoutedCommandBindings.InputBindings="{Binding InputBindings}">

    <Window.Resources>
        <Style x:Key="TabCloseButton" TargetType="{x:Type Button}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="6,0,-2,0" />
            <Setter Property="ToolTip" Value="Close" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Border" Width="14" Height="14" CornerRadius="2" Background="Transparent">
                            <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="DimGray" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#26000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Splitter" TargetType="{x:Type Thumb}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="VerticalSplitter" TargetType="{x:Type Thumb}" BasedOn="{StaticResource Splitter}">
            <Setter Property="Width" Value="5" />
            <Setter Property="Cursor" Value="SizeWE" />
        </Style>

        <Style x:Key="HorizontalSplitter" TargetType="{x:Type Thumb}" BasedOn="{StaticResource Splitter}">
            <Setter Property="Height" Value="5" />
            <Setter Property="Cursor" Value="SizeNS" />
        </Style>

        <Style x:Key="ToolPanel" TargetType="{x:Type TabControl}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ContentTemplateSelector" Value="{StaticResource ViewModelTemplateSelector}" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type shell:Tool}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource TabCloseButton}" Command="{Binding CloseCommand}" />
                            <TextBlock Text="{Binding Title}" FontWeight="Normal" VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type TabItem}" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DocumentTabs" TargetType="{x:Type TabControl}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="ContentTemplateSelector" Value="{StaticResource ViewModelTemplateSelector}" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type shell:Page}">
                        <DockPanel Background="Transparent" ToolTip="{Binding Title}">
                            <DockPanel.InputBindings>
                                <MouseBinding Gesture="MiddleClick" Command="{Binding CloseCommand}" />
                            </DockPanel.InputBindings>
                            <DockPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Close" Command="{Binding CloseCommand}" />
                                    <MenuItem Header="Close All But This" Command="{Binding CloseAllButThisCommand}" />
                                    <MenuItem Header="Close All" Command="{Binding CloseAllPagesCommand}" />
                                </ContextMenu>
                            </DockPanel.ContextMenu>
                            <Button DockPanel.Dock="Right" Style="{StaticResource TabCloseButton}" Command="{Binding CloseCommand}" />
                            <TextBlock FontWeight="Normal" VerticalAlignment="Center">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{StaticResource DirtyTitleConverter}">
                                        <Binding Path="Title" />
                                        <Binding Path="IsDirty" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabControl}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <!-- the tab strip scrolls instead of wrapping; this menu lists all open documents -->
                                <Menu DockPanel.Dock="Right" Background="Transparent" VerticalAlignment="Center">
                                    <MenuItem Header="&#x25BE;" ToolTip="Open documents" Padding="6,0" FontWeight="Normal"
                                              ItemsSource="{TemplateBinding ItemsSource}" Click="DocumentList_Click">
                                        <MenuItem.ItemContainerStyle>
                                            <Style TargetType="{x:Type MenuItem}">
                                                <Setter Property="Header" Value="{Binding Title}" />
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                </Menu>
                                <ScrollViewer x:Name="TabStrip" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False"
                                              PreviewMouseWheel="DocumentTabStrip_PreviewMouseWheel">
                                    <StackPanel Orientation="Horizontal" IsItemsHost="True" />
                                </ScrollViewer>
                            </DockPanel>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}">
                                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                            </Border>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Background="WhiteSmoke" LastChildFill="True">
        <Menu Height="24" VerticalAlignment="Top" DockPanel.Dock="Top"
              ItemsSource="{Binding Workspace.MainMenu.Items}"
              UsesItemContainerTemplate="True"
              ItemContainerTemplateSelector="{StaticResource MenuItemContainerTemplateSelector}">
            <Menu.Resources>
                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="UsesItemContainerTemplate" Value="True" />
                    <Setter Property="ItemContainerTemplateSelector" Value="{StaticResource MenuItemContainerTemplateSelector}" />
                </Style>
            </Menu.Resources>
        </Menu>

        <ToolBar Height="29" Padding="0" Margin="0" Focusable="False"
                 DockPanel.Dock="Top"
                 Visibility="{Binding Path=Workspace.ViewToolbar.Value, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}"
                 ItemsSource="{Binding Workspace.Toolbar.Buttons}"
                 ItemTemplateSelector="{StaticResource ToolbarOptionTemplateSelector}">
            <ToolBar.Resources>
                <Style x:Key="{x:Static ToolBar.ToggleButtonStyleKey}" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}" />
            </ToolBar.Resources>
        </ToolBar>

        <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Workspace.Bars}" ItemTemplateSelector="{StaticResource ViewModelTemplateSelector}" />

        <StatusBar BorderBrush="Silver" BorderThickness="1"
                   DockPanel.Dock="Bottom" Height="24"
                   VerticalAlignment="Bottom"
                   Visibility="{Binding Path=Workspace.ViewStatusBar.Value, Converter={StaticResource BooleanToCollapsedVisibilityConverter}}">
            <StatusBarItem Width="50" BorderBrush="Silver" BorderThickness="0,0,1,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center">Status:</StatusBarItem>
            <StatusBarItem Width="300" Padding="10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Background tasks running: " />
                    <TextBlock Text="{Binding Workspace.Scheduler.Jobs.Count}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Width="100" BorderBrush="Silver" Padding="10,0" BorderThickness="1,0,0,0" Content="{Binding WindowService.ActiveContent.Status}" VerticalContentAlignment="Center" />
            <StatusBarItem Width="100" BorderBrush="Silver" Padding="10,0" BorderThickness="1,0,0,0" Content="{Binding WindowService.ActiveContent.Operation}" VerticalContentAlignment="Center" />
            <StatusBarItem BorderBrush="Silver" Padding="5,0" BorderThickness="1,0,0,0" VerticalContentAlignment="Center" >
                <Grid HorizontalAlignment="Stretch" Visibility="{Binding Path=Workspace.ProgressText, Converter={StaticResource NullToVisibilityConverter}}" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="21" />
                        <ColumnDefinition Width="165" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"  Source="{StaticResource fugue-drive-download}" Height="16" Width="16" />
                    <ProgressBar Grid.Column="1" Value="{Binding Workspace.Progress}" HorizontalAlignment="Stretch"  Orientation="Horizontal" Grid.ZIndex="0" />
                    <TextBlock Grid.Column="1"  Text="{Binding Workspace.ProgressText}" Grid.ZIndex="1" />
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <DockPanel Margin="2">
            <TabControl x:Name="LeftPanel" DockPanel.Dock="Left" Style="{StaticResource ToolPanel}"
                        ItemsSource="{Binding WindowService.LeftTools}"
                        Width="{Binding Workspace.LeftPanelWidth.Value, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                        Visibility="{Binding WindowService.LeftTools.Count, Converter={StaticResource IntToVisibilityConverter}}" />
            <Thumb DockPanel.Dock="Left" Style="{StaticResource VerticalSplitter}" Tag="{Binding ElementName=LeftPanel}"
                   DragDelta="Splitter_DragDelta" DragCompleted="Splitter_DragCompleted"
                   Visibility="{Binding Visibility, ElementName=LeftPanel}" />

            <TabControl x:Name="RightPanel" DockPanel.Dock="Right" Style="{StaticResource ToolPanel}"
                        ItemsSource="{Binding WindowService.RightTools}"
                        Width="{Binding Workspace.RightPanelWidth.Value, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                        Visibility="{Binding WindowService.RightTools.Count, Converter={StaticResource IntToVisibilityConverter}}" />
            <Thumb DockPanel.Dock="Right" Style="{StaticResource VerticalSplitter}" Tag="{Binding ElementName=RightPanel}"
                   DragDelta="Splitter_DragDelta" DragCompleted="Splitter_DragCompleted"
                   Visibility="{Binding Visibility, ElementName=RightPanel}" />

            <DockPanel>
                <TabControl x:Name="BottomPanel" DockPanel.Dock="Bottom" Style="{StaticResource ToolPanel}"
                            ItemsSource="{Binding WindowService.BottomTools}"
                            Height="{Binding Workspace.BottomPanelHeight.Value, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                            Visibility="{Binding WindowService.BottomTools.Count, Converter={StaticResource IntToVisibilityConverter}}" />
                <Thumb DockPanel.Dock="Bottom" Style="{StaticResource HorizontalSplitter}" Tag="{Binding ElementName=BottomPanel}"
                       DragDelta="Splitter_DragDelta" DragCompleted="Splitter_DragCompleted"
                       Visibility="{Binding Visibility, ElementName=BottomPanel}" />

                <TabControl x:Name="DocumentTabs" Style="{StaticResource DocumentTabs}"
                            ItemsSource="{Binding WindowService.Pages}"
                            SelectedItem="{Binding WindowService.SelectedPage, Mode=TwoWay}"
                            SelectionChanged="DocumentTabs_SelectionChanged" />
            </DockPanel>
        </DockPanel>
    </DockPanel>
</Window>
