<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net11.0-windows</TargetFramework>
        <IsPackable>false</IsPackable>
        <GenerateRuntimeConfigurationFiles>True</GenerateRuntimeConfigurationFiles>
        <AssemblyName>HerculesTests</AssemblyName>
        <Nullable>enable</Nullable>
        <RootNamespace>Hercules</RootNamespace>
     </PropertyGroup>
    <ItemGroup>
      <PackageReference Include="Jint" Version="4.17.0" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
      <PackageReference Include="Microsoft.Reactive.Testing" Version="7.0.0" />
      <PackageReference Include="Moq" Version="4.21.0" />
      <PackageReference Include="NUnit" Version="5.0.0" />
      <PackageReference Include="NUnit3TestAdapter" Version="6.3.1">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\Hercules\Hercules.csproj" />
    </ItemGroup>
    <ItemGroup>
      <EmbeddedResource Include="Resources\**\*" />
    </ItemGroup>
</Project>